{"category":"BalaC","color":"#f51414","blocks":["__BalaC_setup","__BalaC_calibration","__BalaC_PID","__BalaC_Balancing"],"jscode":"// Block __BalaC_setup\nvar __BalaC_setup_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BalaC setup\"\n        }\n    ],\n    \"colour\": \"#f51414\"\n};\n\nwindow['Blockly'].Blocks['__BalaC_setup'] = {\n    init: function() {\n        this.jsonInit(__BalaC_setup_json);\n    }\n};\n\nwindow['Blockly'].Python['__BalaC_setup'] = function(block) {\n        return `\nimport imu\nfrom machine import I2C, Pin\nimport time\n\nstart_request = False\n\n# Costanti di configurazione\nI2C_ADDR = 0x38\nI2C_SDA = 0\nI2C_SCL = 26\nLED_PIN = 10\nN_CAL1 = 100\nN_CAL2 = 100\nLCDV_MID = 60\nclk = 0.01\ninterval = int(clk * 1000)\ncutoff = 0.1\n\n# Parametri del controllore\nKang = 37.0 #P\nKomg = 0.84 #D\nKIang = 800.0 #I\nKdst = 85.0\nKspd = 2.7\nfbBalance = -3\n\nvarSpd = 0.0\nvarDst = 0.0\nmoveTarget = 0.0\nmoveStep = 0.2 * clk\n\nmechFactL = 0.45\nmechFactR = 0.45\nmotorDeadband = 10\nmaxPwr = 120\npunchPwr = 20\npunchDur = 1\nmaxOvp = 20\nFALL_ANGLE = 40.0\n\n# Variabili globali\nserialMonitor = True\nstanding = False\n\ncounterOverPwr = 0\n\ngyroYoffset = 0.0\ngyroZoffset = 0.0\naccXoffset = 0.0\n\ngyroXdata = 0.0\ngyroYdata = 0.0\ngyroZdata = 0.0\naccXdata = 0.0\naccZdata = 0.0\n\nvarAng = 0.0\nvarOmg = 0.0\nvarIang = 0.0\n\npower = 0.0\npowerR = 0.0\npowerL = 0.0\n\nmotorLdir = 0\nmotorRdir = 0\npunchCountL = 0\npunchCountR = 0\n\nvoltAve = 3.7\naveAccZ = 0.0\naveAbsOmg = 0.0\n\ni2c_bus = None\nled = None\nimu0 = None\nbtn_press_start = None\nbtn_debounce = False\n\nlcd.setRotation(2)\nsetScreenColor(0x000000)\n\ni2c_bus = I2C(scl=Pin(I2C_SCL), sda=Pin(I2C_SDA))\nled = Pin(LED_PIN, Pin.OUT)\nled.value(1)\n\nimu0 = imu.IMU()\n\npunchPwr2 = max(punchPwr, motorDeadband)\n\nlcd.setCursor(0, 0)\nlcd.print(\"BalaC\")\n\n# Funzioni di supporto motori\ndef drvMotor(ch, sp):\n    sp = max(-127, min(127, sp))\n    sp_byte = sp & 0xFF\n\n    i2c_bus.writeto(I2C_ADDR, bytes((ch & 0xFF, sp_byte)))\n\n\ndef drvMotorL(pwm):\n    drvMotor(0, pwm)\n\ndef drvMotorR(pwm):\n    drvMotor(1, -pwm)\n\n#reset parametri\ndef resetMotor():\n    global counterOverPwr\n    drvMotorL(0)\n    drvMotorR(0)\n    counterOverPwr = 0\n\ndef resetVar():\n    global power, varAng, varOmg, varIang\n    global powerR, powerL\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global varSpd, varDst, moveTarget\n    power = 0.0\n    powerR = 0.0\n    powerL = 0.0\n    varAng = 0.0\n    varOmg = 0.0\n    varIang = 0.0\n    motorLdir = 0\n    motorRdir = 0\n    punchCountL = 0\n    punchCountR = 0\n    varSpd = 0.0\n    varDst = 0.0\n    moveTarget = 0.0\n\ndef readGyro():\n    global gyroXdata, gyroYdata, gyroZdata, accXdata, accZdata\n    g = imu0.gyro\n    a = imu0.acceleration\n    gyroYdata = g[0]\n    gyroZdata = -g[1]\n    gyroXdata = -g[2]\n    accXdata = a[2]\n    accZdata = a[1]\n\ndef getGyro():\n    global varOmg, varAng\n    readGyro()\n    varOmg = (gyroYdata - gyroYoffset)\n    acc_angle = (accXdata - accXoffset) * 57.3\n    varAng += (varOmg + (acc_angle - varAng) * cutoff) * clk\n\n#calibrazioni\ndef calDelay(n):\n    for _ in range(n):\n        getGyro()\n        wait_ms(9)\n\ndef calib1():\n    global gyroYoffset\n    calDelay(30)\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 1\")\n    gyroYoffset = 0.0\n    for _ in range(N_CAL1):\n        readGyro()\n        gyroYoffset += gyroYdata\n        wait_ms(9)\n    gyroYoffset /= float(N_CAL1)\n    lcd.fillScreen(0x000000)\n    led.value(1)\n\ndef calib2():\n    global accXoffset, gyroZoffset\n    resetVar()\n    resetMotor()\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 2\")\n    accXoffset = 0.0\n    gyroZoffset = 0.0\n    for _ in range(N_CAL2):\n        readGyro()\n        accXoffset += accXdata\n        gyroZoffset += gyroZdata\n        wait_ms(9)\n    accXoffset /= float(N_CAL2)\n    gyroZoffset /= float(N_CAL2)\n\ndef show_prompt():\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Stand up\")\n    lcd.setCursor(10, 60)\n    lcd.print(\"Press A\")\n\nresetVar()\nresetMotor()\ncalib1()\nshow_prompt()\n\nt0 = time.ticks_ms()` + \"\\n\";\n};\n\n// Block __BalaC_calibration\nvar __BalaC_calibration_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BalaC calibration\"\n        }\n    ],\n    \"colour\": \"#f51414\"\n};\n\nwindow['Blockly'].Blocks['__BalaC_calibration'] = {\n    init: function() {\n        this.jsonInit(__BalaC_calibration_json);\n    }\n};\n\nwindow['Blockly'].Python['__BalaC_calibration'] = function(block) {\n        return ` \nglobal start_request\nstart_request = True\n\n` + \"\\n\";\n};\n\n// Block __BalaC_PID\nvar __BalaC_PID_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BalaC PID\"\n        }\n    ],\n    \"message1\": \"%1 %2\",\n    \"args1\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Kp\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"Kp\"\n        }\n    ],\n    \"message2\": \"%1 %2\",\n    \"args2\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Ki\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"Ki\"\n        }\n    ],\n    \"message3\": \"%1 %2\",\n    \"args3\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"Kd\"\n        },\n        {\n            \"type\": \"field_number\",\n            \"value\": 0,\n            \"name\": \"Kd\"\n        }\n    ],\n    \"colour\": \"#f51414\"\n};\n\nwindow['Blockly'].Blocks['__BalaC_PID'] = {\n    init: function() {\n        this.jsonInit(__BalaC_PID_json);\n    }\n};\n\nwindow['Blockly'].Python['__BalaC_PID'] = function(block) {\n    var Kp = block.getFieldValue('Kp');\nvar Ki = block.getFieldValue('Ki');\nvar Kd = block.getFieldValue('Kd');\n    return `\nKang = float(${Kp})\nKomg = float(${Kd})\nKIang = float(${Ki})` + \"\\n\";\n};\n\n// Block __BalaC_Balancing\nvar __BalaC_Balancing_json = {\n    \"previousStatement\": null,\n    \"nextStatement\": null,\n    \"message0\": \"%1\",\n    \"args0\": [\n        {\n            \"type\": \"field_label\",\n            \"text\": \"BalaC balancing\"\n        }\n    ],\n    \"colour\": \"#f51414\"\n};\n\nwindow['Blockly'].Blocks['__BalaC_Balancing'] = {\n    init: function() {\n        this.jsonInit(__BalaC_Balancing_json);\n    }\n};\n\nwindow['Blockly'].Python['__BalaC_Balancing'] = function(block) {\n        return `\ndef drive():\n    global varIang, power, powerR, powerL, counterOverPwr\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global punchPwr2, moveTarget, varSpd, varDst\n    moveTarget += moveStep * (0.0 + fbBalance/100.0)\n\n    varSpd += power * clk\n    varDst += Kdst * (varSpd * clk - moveTarget)\n    varIang += KIang * varAng * clk\n\n    power = varIang + varDst + (Kspd * varSpd) + (Kang * varAng) + (Komg * varOmg)\n    if abs(power) > 1000.0:\n        counterOverPwr += 1\n    else:\n        counterOverPwr = 0\n    if counterOverPwr > maxOvp:\n        resetMotor()\n        resetVar()\n        return\n    power = max(-maxPwr, min(maxPwr, power))\n    powerR = power\n    powerL = power\n    ipowerL = int(max(-maxPwr, min(maxPwr, powerL * mechFactL)))\n    ipowerR = int(max(-maxPwr, min(maxPwr, powerR * mechFactR)))\n    if ipowerL > 0:\n        punchCountL = punchCountL + 1 if motorLdir == 1 else 0\n        motorLdir = 1\n        if punchCountL < punchDur:\n            drvMotorL(max(ipowerL, punchPwr2))\n        else:\n            drvMotorL(max(ipowerL, motorDeadband))\n    elif ipowerL < 0:\n        punchCountL = punchCountL + 1 if motorLdir == -1 else 0\n        motorLdir = -1\n        if punchCountL < punchDur:\n            drvMotorL(min(ipowerL, -punchPwr2))\n        else:\n            drvMotorL(min(ipowerL, -motorDeadband))\n    else:\n        drvMotorL(0)\n        motorLdir = 0\n        punchCountL = 0\n    if ipowerR > 0:\n        punchCountR = punchCountR + 1 if motorRdir == 1 else 0\n        motorRdir = 1\n        if punchCountR < punchDur:\n            drvMotorR(max(ipowerR, punchPwr2))\n        else:\n            drvMotorR(max(ipowerR, motorDeadband))\n    elif ipowerR < 0:\n        punchCountR = punchCountR + 1 if motorRdir == -1 else 0\n        motorRdir = -1\n        if punchCountR < punchDur:\n            drvMotorR(min(ipowerR, -punchPwr2))\n        else:\n            drvMotorR(min(ipowerR, -motorDeadband))\n    else:\n        drvMotorR(0)\n        motorRdir = 0\n        punchCountR = 0\n\nif start_request and (not standing):\n    start_request = False \n    calib2()\n    standing = True\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Balancing...\")\n\ngetGyro()\nif not standing:\n    resetMotor()\nelse:\n    if abs(varAng) > FALL_ANGLE or counterOverPwr > maxOvp:\n            resetMotor()\n            resetVar()\n            standing = False\n            show_prompt()\n    else:\n            drive()` + \"\\n\";\n};\n\n","code":{"setup":["window['Blockly'].Python['__BalaC_setup'] = function(block) {\n        return `\nimport imu\nfrom machine import I2C, Pin\nimport time\n\nstart_request = False\n\n# Costanti di configurazione\nI2C_ADDR = 0x38\nI2C_SDA = 0\nI2C_SCL = 26\nLED_PIN = 10\nN_CAL1 = 100\nN_CAL2 = 100\nLCDV_MID = 60\nclk = 0.01\ninterval = int(clk * 1000)\ncutoff = 0.1\n\n# Parametri del controllore\nKang = 37.0 #P\nKomg = 0.84 #D\nKIang = 800.0 #I\nKdst = 85.0\nKspd = 2.7\nfbBalance = -3\n\nvarSpd = 0.0\nvarDst = 0.0\nmoveTarget = 0.0\nmoveStep = 0.2 * clk\n\nmechFactL = 0.45\nmechFactR = 0.45\nmotorDeadband = 10\nmaxPwr = 120\npunchPwr = 20\npunchDur = 1\nmaxOvp = 20\nFALL_ANGLE = 40.0\n\n# Variabili globali\nserialMonitor = True\nstanding = False\n\ncounterOverPwr = 0\n\ngyroYoffset = 0.0\ngyroZoffset = 0.0\naccXoffset = 0.0\n\ngyroXdata = 0.0\ngyroYdata = 0.0\ngyroZdata = 0.0\naccXdata = 0.0\naccZdata = 0.0\n\nvarAng = 0.0\nvarOmg = 0.0\nvarIang = 0.0\n\npower = 0.0\npowerR = 0.0\npowerL = 0.0\n\nmotorLdir = 0\nmotorRdir = 0\npunchCountL = 0\npunchCountR = 0\n\nvoltAve = 3.7\naveAccZ = 0.0\naveAbsOmg = 0.0\n\ni2c_bus = None\nled = None\nimu0 = None\nbtn_press_start = None\nbtn_debounce = False\n\nlcd.setRotation(2)\nsetScreenColor(0x000000)\n\ni2c_bus = I2C(scl=Pin(I2C_SCL), sda=Pin(I2C_SDA))\nled = Pin(LED_PIN, Pin.OUT)\nled.value(1)\n\nimu0 = imu.IMU()\n\npunchPwr2 = max(punchPwr, motorDeadband)\n\nlcd.setCursor(0, 0)\nlcd.print(\"BalaC\")\n\n# Funzioni di supporto motori\ndef drvMotor(ch, sp):\n    sp = max(-127, min(127, sp))\n    sp_byte = sp & 0xFF\n\n    i2c_bus.writeto(I2C_ADDR, bytes((ch & 0xFF, sp_byte)))\n\n\ndef drvMotorL(pwm):\n    drvMotor(0, pwm)\n\ndef drvMotorR(pwm):\n    drvMotor(1, -pwm)\n\n#reset parametri\ndef resetMotor():\n    global counterOverPwr\n    drvMotorL(0)\n    drvMotorR(0)\n    counterOverPwr = 0\n\ndef resetVar():\n    global power, varAng, varOmg, varIang\n    global powerR, powerL\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global varSpd, varDst, moveTarget\n    power = 0.0\n    powerR = 0.0\n    powerL = 0.0\n    varAng = 0.0\n    varOmg = 0.0\n    varIang = 0.0\n    motorLdir = 0\n    motorRdir = 0\n    punchCountL = 0\n    punchCountR = 0\n    varSpd = 0.0\n    varDst = 0.0\n    moveTarget = 0.0\n\ndef readGyro():\n    global gyroXdata, gyroYdata, gyroZdata, accXdata, accZdata\n    g = imu0.gyro\n    a = imu0.acceleration\n    gyroYdata = g[0]\n    gyroZdata = -g[1]\n    gyroXdata = -g[2]\n    accXdata = a[2]\n    accZdata = a[1]\n\ndef getGyro():\n    global varOmg, varAng\n    readGyro()\n    varOmg = (gyroYdata - gyroYoffset)\n    acc_angle = (accXdata - accXoffset) * 57.3\n    varAng += (varOmg + (acc_angle - varAng) * cutoff) * clk\n\n#calibrazioni\ndef calDelay(n):\n    for _ in range(n):\n        getGyro()\n        wait_ms(9)\n\ndef calib1():\n    global gyroYoffset\n    calDelay(30)\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 1\")\n    gyroYoffset = 0.0\n    for _ in range(N_CAL1):\n        readGyro()\n        gyroYoffset += gyroYdata\n        wait_ms(9)\n    gyroYoffset /= float(N_CAL1)\n    lcd.fillScreen(0x000000)\n    led.value(1)\n\ndef calib2():\n    global accXoffset, gyroZoffset\n    resetVar()\n    resetMotor()\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 2\")\n    accXoffset = 0.0\n    gyroZoffset = 0.0\n    for _ in range(N_CAL2):\n        readGyro()\n        accXoffset += accXdata\n        gyroZoffset += gyroZdata\n        wait_ms(9)\n    accXoffset /= float(N_CAL2)\n    gyroZoffset /= float(N_CAL2)\n\ndef show_prompt():\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Stand up\")\n    lcd.setCursor(10, 60)\n    lcd.print(\"Press A\")\n\nresetVar()\nresetMotor()\ncalib1()\nshow_prompt()\n\nt0 = time.ticks_ms()` + \"\\n\";\n};\n\n","\nimport imu\nfrom machine import I2C, Pin\nimport time\n\nstart_request = False\n\n# Costanti di configurazione\nI2C_ADDR = 0x38\nI2C_SDA = 0\nI2C_SCL = 26\nLED_PIN = 10\nN_CAL1 = 100\nN_CAL2 = 100\nLCDV_MID = 60\nclk = 0.01\ninterval = int(clk * 1000)\ncutoff = 0.1\n\n# Parametri del controllore\nKang = 37.0 #P\nKomg = 0.84 #D\nKIang = 800.0 #I\nKdst = 85.0\nKspd = 2.7\nfbBalance = -3\n\nvarSpd = 0.0\nvarDst = 0.0\nmoveTarget = 0.0\nmoveStep = 0.2 * clk\n\nmechFactL = 0.45\nmechFactR = 0.45\nmotorDeadband = 10\nmaxPwr = 120\npunchPwr = 20\npunchDur = 1\nmaxOvp = 20\nFALL_ANGLE = 40.0\n\n# Variabili globali\nserialMonitor = True\nstanding = False\n\ncounterOverPwr = 0\n\ngyroYoffset = 0.0\ngyroZoffset = 0.0\naccXoffset = 0.0\n\ngyroXdata = 0.0\ngyroYdata = 0.0\ngyroZdata = 0.0\naccXdata = 0.0\naccZdata = 0.0\n\nvarAng = 0.0\nvarOmg = 0.0\nvarIang = 0.0\n\npower = 0.0\npowerR = 0.0\npowerL = 0.0\n\nmotorLdir = 0\nmotorRdir = 0\npunchCountL = 0\npunchCountR = 0\n\nvoltAve = 3.7\naveAccZ = 0.0\naveAbsOmg = 0.0\n\ni2c_bus = None\nled = None\nimu0 = None\nbtn_press_start = None\nbtn_debounce = False\n\nlcd.setRotation(2)\nsetScreenColor(0x000000)\n\ni2c_bus = I2C(scl=Pin(I2C_SCL), sda=Pin(I2C_SDA))\nled = Pin(LED_PIN, Pin.OUT)\nled.value(1)\n\nimu0 = imu.IMU()\n\npunchPwr2 = max(punchPwr, motorDeadband)\n\nlcd.setCursor(0, 0)\nlcd.print(\"BalaC\")\n\n# Funzioni di supporto motori\ndef drvMotor(ch, sp):\n    sp = max(-127, min(127, sp))\n    sp_byte = sp & 0xFF\n\n    i2c_bus.writeto(I2C_ADDR, bytes((ch & 0xFF, sp_byte)))\n\n\ndef drvMotorL(pwm):\n    drvMotor(0, pwm)\n\ndef drvMotorR(pwm):\n    drvMotor(1, -pwm)\n\n#reset parametri\ndef resetMotor():\n    global counterOverPwr\n    drvMotorL(0)\n    drvMotorR(0)\n    counterOverPwr = 0\n\ndef resetVar():\n    global power, varAng, varOmg, varIang\n    global powerR, powerL\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global varSpd, varDst, moveTarget\n    power = 0.0\n    powerR = 0.0\n    powerL = 0.0\n    varAng = 0.0\n    varOmg = 0.0\n    varIang = 0.0\n    motorLdir = 0\n    motorRdir = 0\n    punchCountL = 0\n    punchCountR = 0\n    varSpd = 0.0\n    varDst = 0.0\n    moveTarget = 0.0\n\ndef readGyro():\n    global gyroXdata, gyroYdata, gyroZdata, accXdata, accZdata\n    g = imu0.gyro\n    a = imu0.acceleration\n    gyroYdata = g[0]\n    gyroZdata = -g[1]\n    gyroXdata = -g[2]\n    accXdata = a[2]\n    accZdata = a[1]\n\ndef getGyro():\n    global varOmg, varAng\n    readGyro()\n    varOmg = (gyroYdata - gyroYoffset)\n    acc_angle = (accXdata - accXoffset) * 57.3\n    varAng += (varOmg + (acc_angle - varAng) * cutoff) * clk\n\n#calibrazioni\ndef calDelay(n):\n    for _ in range(n):\n        getGyro()\n        wait_ms(9)\n\ndef calib1():\n    global gyroYoffset\n    calDelay(30)\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 1\")\n    gyroYoffset = 0.0\n    for _ in range(N_CAL1):\n        readGyro()\n        gyroYoffset += gyroYdata\n        wait_ms(9)\n    gyroYoffset /= float(N_CAL1)\n    lcd.fillScreen(0x000000)\n    led.value(1)\n\ndef calib2():\n    global accXoffset, gyroZoffset\n    resetVar()\n    resetMotor()\n    led.value(0)\n    calDelay(80)\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(30, LCDV_MID)\n    lcd.print(\"Cal 2\")\n    accXoffset = 0.0\n    gyroZoffset = 0.0\n    for _ in range(N_CAL2):\n        readGyro()\n        accXoffset += accXdata\n        gyroZoffset += gyroZdata\n        wait_ms(9)\n    accXoffset /= float(N_CAL2)\n    gyroZoffset /= float(N_CAL2)\n\ndef show_prompt():\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Stand up\")\n    lcd.setCursor(10, 60)\n    lcd.print(\"Press A\")\n\nresetVar()\nresetMotor()\ncalib1()\nshow_prompt()\n\nt0 = time.ticks_ms()"],"calibration":["window['Blockly'].Python['__BalaC_calibration'] = function(block) {\n        return ` \nglobal start_request\nstart_request = True\n\n` + \"\\n\";\n};\n\n"," \nglobal start_request\nstart_request = True\n\n"],"PID":["window['Blockly'].Python['__BalaC_PID'] = function(block) {\n    var Kp = block.getFieldValue('Kp');\nvar Ki = block.getFieldValue('Ki');\nvar Kd = block.getFieldValue('Kd');\n    return `\nKang = float(${Kp})\nKomg = float(${Kd})\nKIang = float(${Ki})` + \"\\n\";\n};\n\n","\nKang = float(${Kp})\nKomg = float(${Kd})\nKIang = float(${Ki})"],"Balancing":["window['Blockly'].Python['__BalaC_Balancing'] = function(block) {\n        return `\ndef drive():\n    global varIang, power, powerR, powerL, counterOverPwr\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global punchPwr2, moveTarget, varSpd, varDst\n    moveTarget += moveStep * (0.0 + fbBalance/100.0)\n\n    varSpd += power * clk\n    varDst += Kdst * (varSpd * clk - moveTarget)\n    varIang += KIang * varAng * clk\n\n    power = varIang + varDst + (Kspd * varSpd) + (Kang * varAng) + (Komg * varOmg)\n    if abs(power) > 1000.0:\n        counterOverPwr += 1\n    else:\n        counterOverPwr = 0\n    if counterOverPwr > maxOvp:\n        resetMotor()\n        resetVar()\n        return\n    power = max(-maxPwr, min(maxPwr, power))\n    powerR = power\n    powerL = power\n    ipowerL = int(max(-maxPwr, min(maxPwr, powerL * mechFactL)))\n    ipowerR = int(max(-maxPwr, min(maxPwr, powerR * mechFactR)))\n    if ipowerL > 0:\n        punchCountL = punchCountL + 1 if motorLdir == 1 else 0\n        motorLdir = 1\n        if punchCountL < punchDur:\n            drvMotorL(max(ipowerL, punchPwr2))\n        else:\n            drvMotorL(max(ipowerL, motorDeadband))\n    elif ipowerL < 0:\n        punchCountL = punchCountL + 1 if motorLdir == -1 else 0\n        motorLdir = -1\n        if punchCountL < punchDur:\n            drvMotorL(min(ipowerL, -punchPwr2))\n        else:\n            drvMotorL(min(ipowerL, -motorDeadband))\n    else:\n        drvMotorL(0)\n        motorLdir = 0\n        punchCountL = 0\n    if ipowerR > 0:\n        punchCountR = punchCountR + 1 if motorRdir == 1 else 0\n        motorRdir = 1\n        if punchCountR < punchDur:\n            drvMotorR(max(ipowerR, punchPwr2))\n        else:\n            drvMotorR(max(ipowerR, motorDeadband))\n    elif ipowerR < 0:\n        punchCountR = punchCountR + 1 if motorRdir == -1 else 0\n        motorRdir = -1\n        if punchCountR < punchDur:\n            drvMotorR(min(ipowerR, -punchPwr2))\n        else:\n            drvMotorR(min(ipowerR, -motorDeadband))\n    else:\n        drvMotorR(0)\n        motorRdir = 0\n        punchCountR = 0\n\nif start_request and (not standing):\n    start_request = False \n    calib2()\n    standing = True\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Balancing...\")\n\ngetGyro()\nif not standing:\n    resetMotor()\nelse:\n    if abs(varAng) > FALL_ANGLE or counterOverPwr > maxOvp:\n            resetMotor()\n            resetVar()\n            standing = False\n            show_prompt()\n    else:\n            drive()` + \"\\n\";\n};\n\n","\ndef drive():\n    global varIang, power, powerR, powerL, counterOverPwr\n    global motorLdir, motorRdir, punchCountL, punchCountR\n    global punchPwr2, moveTarget, varSpd, varDst\n    moveTarget += moveStep * (0.0 + fbBalance/100.0)\n\n    varSpd += power * clk\n    varDst += Kdst * (varSpd * clk - moveTarget)\n    varIang += KIang * varAng * clk\n\n    power = varIang + varDst + (Kspd * varSpd) + (Kang * varAng) + (Komg * varOmg)\n    if abs(power) > 1000.0:\n        counterOverPwr += 1\n    else:\n        counterOverPwr = 0\n    if counterOverPwr > maxOvp:\n        resetMotor()\n        resetVar()\n        return\n    power = max(-maxPwr, min(maxPwr, power))\n    powerR = power\n    powerL = power\n    ipowerL = int(max(-maxPwr, min(maxPwr, powerL * mechFactL)))\n    ipowerR = int(max(-maxPwr, min(maxPwr, powerR * mechFactR)))\n    if ipowerL > 0:\n        punchCountL = punchCountL + 1 if motorLdir == 1 else 0\n        motorLdir = 1\n        if punchCountL < punchDur:\n            drvMotorL(max(ipowerL, punchPwr2))\n        else:\n            drvMotorL(max(ipowerL, motorDeadband))\n    elif ipowerL < 0:\n        punchCountL = punchCountL + 1 if motorLdir == -1 else 0\n        motorLdir = -1\n        if punchCountL < punchDur:\n            drvMotorL(min(ipowerL, -punchPwr2))\n        else:\n            drvMotorL(min(ipowerL, -motorDeadband))\n    else:\n        drvMotorL(0)\n        motorLdir = 0\n        punchCountL = 0\n    if ipowerR > 0:\n        punchCountR = punchCountR + 1 if motorRdir == 1 else 0\n        motorRdir = 1\n        if punchCountR < punchDur:\n            drvMotorR(max(ipowerR, punchPwr2))\n        else:\n            drvMotorR(max(ipowerR, motorDeadband))\n    elif ipowerR < 0:\n        punchCountR = punchCountR + 1 if motorRdir == -1 else 0\n        motorRdir = -1\n        if punchCountR < punchDur:\n            drvMotorR(min(ipowerR, -punchPwr2))\n        else:\n            drvMotorR(min(ipowerR, -motorDeadband))\n    else:\n        drvMotorR(0)\n        motorRdir = 0\n        punchCountR = 0\n\nif start_request and (not standing):\n    start_request = False \n    calib2()\n    standing = True\n    lcd.fillScreen(0x000000)\n    lcd.setCursor(10, 10)\n    lcd.print(\"Balancing...\")\n\ngetGyro()\nif not standing:\n    resetMotor()\nelse:\n    if abs(varAng) > FALL_ANGLE or counterOverPwr > maxOvp:\n            resetMotor()\n            resetVar()\n            standing = False\n            show_prompt()\n    else:\n            drive()"]}}